# Copy to .env and adjust. .env is git-ignored and must never be committed.

# --- database ---
POSTGRES_USER=devflow
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=devflow
POSTGRES_PORT=5432

# Read by the API. Use the sqlite form for a zero-dependency local run:
#   DATABASE_URL=sqlite:///./devflow.db
DATABASE_URL=postgresql+psycopg://devflow:change-this-password@localhost:5432/devflow

# --- security ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-random-value-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false
SEED_ON_STARTUP=false

# Comma-separated list of allowed browser origins, or * to allow any.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- ports (docker compose) ---
API_PORT=8000
WEB_PORT=8080

# --- frontend ---
# Base URL the browser uses to reach the API. Left relative in Docker so nginx proxies it.
VITE_API_URL=http://localhost:8000/api/v1
